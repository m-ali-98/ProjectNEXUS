# ---------------------------------------------------------------------------
# NEXUS environment configuration
# ---------------------------------------------------------------------------
# Contact form delivery. The form performs full validation, honeypot and
# rate-limiting without these values, but will clearly report that delivery is
# not configured instead of pretending a message was sent.
#
# Resend (https://resend.com) — server-side only. Never expose these to the client.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="NEXUS Contact <onboarding@resend.dev>"

# Public site URL used for metadata / sitemap / Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: overrides public contact placeholders shown in the Contact room.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
