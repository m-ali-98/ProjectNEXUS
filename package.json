{
  "name": "nexus",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS \u2014 an immersive, explorable 3D engineering portfolio",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:world": "tsx scripts/validate-world.ts",
    "verify:connectivity": "tsx scripts/validate-connectivity.ts",
    "verify:session": "tsx scripts/simulate-session.ts",
    "verify:render": "tsx --tsconfig scripts/tsconfig.smoke.json scripts/smoke-render.mts",
    "verify:ui": "tsx --tsconfig scripts/tsconfig.smoke.json scripts/smoke-ui.mts",
    "verify": "npm run verify:world && npm run verify:connectivity && npm run verify:session && npm run verify:render && npm run verify:ui",
    "optimise:model": "bash scripts/optimise-model.sh",
    "verify:character": "tsx scripts/validate-character.ts",
    "preview:model": "tsx scripts/preview-model.ts --anim walk --time 0.3"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "framer-motion": "12.43.0",
    "gsap": "3.15.1",
    "next": "15.5.29",
    "postprocessing": "6.39.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@react-three/test-renderer": "^9.1.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "jpeg-js": "^0.4.4",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
